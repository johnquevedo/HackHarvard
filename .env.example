NODE_ENV=development
DENNIS_MODE=sim
CONVERSATION_MODE=normal
# Optional macOS voice for Dennis's closing-bell voice notes (see `say -v '?'`); blank uses the system voice.
DENNIS_VOICE=
PORT_SERVER=4104
PORT_WEB=3104
DATABASE_URL=file:./data/a4.db
DENNIS_ADMIN_TOKEN=local-demo-admin-token
DENNIS_TZ=America/New_York
DENNIS_REGION_CODE=boston-cambridge
DENNIS_ACK_MODE=none
APPROVAL_TTL_MINUTES=30
LOG_LEVEL=info
NEXT_PUBLIC_API_MODE=mock
API_BASE_URL=http://localhost:4104
DEMO_ALICE_HANDLE=alice@example.test
DEMO_BOB_HANDLE=bob@example.test
# Current group-chat demo cast. Use E.164 phone numbers or Apple ID emails.
DEMO_JOHN_HANDLE=john@example.test
DEMO_STEVEN_HANDLE=steven@example.test
DEMO_ISAAC_HANDLE=isaac@example.test
# Seeded matching friend; this person is not a member of the live demo group.
DEMO_FRIEND_HANDLE=friend@example.test
DEMO_SCENARIO=group
PHOTON_MODE=sim
PHOTON_API_BASE_URL=https://api.photon.codes
PHOTON_PROJECT_ID=
# Spectrum Cloud credential shown as "Project secret" in the Photon dashboard.
PHOTON_PROJECT_SECRET=
# Legacy Photon Beta credentials; leave blank for Spectrum projects.
PHOTON_API_KEY=
PHOTON_AGENT_USER_ID=
PHOTON_INBOUND=socketio
PHOTON_SPACE_MODE=either
PHOTON_SOCKET_URL=
PHOTON_WEBHOOK_SECRET=
PHOTON_ACCOUNT_KEY=primary
NESSIE_MODE=sim
NESSIE_API_KEY=
NESSIE_BASE_URL=
NESSIE_MAX_TRANSFER_CENTS=50000
NESSIE_RUN_TAG=
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_MS=8000
CHALK_API_TOKEN=
CHALK_GATEWAY_BASE_URL=
CHALK_GATEWAY_MODEL=
LIVE_TESTS=0
