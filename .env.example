NODE_ENV=development
DENNIS_MODE=sim
CONVERSATION_MODE=normal
PORT_SERVER=4104
PORT_WEB=3104
DATABASE_URL=file:./data/a4.db
DENNIS_ADMIN_TOKEN=local-demo-admin-token
DENNIS_TZ=America/New_York
DENNIS_REGION_CODE=boston-cambridge
# Tapbacks + typing: set reaction so demo agents seed ackMode=reaction
# (platform foundation). Works on Spectrum + Beta once seeded + messaging consent.
# Default none leaves hackathon demos unchanged.
DENNIS_ACK_MODE=none
# Optional tapback emoji when ackMode=reaction (Beta provider still hardcoded 👍 until CR-A4-001).
DENNIS_PHOTON_ACK_REACTION=👍
# Photon Beta 1.0 additive outbound — off by default; needs A1 PhotonBetaProvider wire-up.
DENNIS_PHOTON_NATIVE_ATTACHMENT=0
DENNIS_PHOTON_NATIVE_VOICE=0
DENNIS_PHOTON_NATIVE_READ=0
# Spectrum Cloud Vincent surfaces — send via: pnpm photon:send-native
# Requires PHOTON_PROJECT_ID (UUID) + PHOTON_PROJECT_SECRET. Off by default.
DENNIS_PHOTON_SPECTRUM_WEBAPP=0
DENNIS_PHOTON_SPECTRUM_CONTACT_CARD=0
# Closest outbound "live location": maps URL as app({ live }) / richlink (not Apple live-share).
DENNIS_PHOTON_SPECTRUM_LIVE_LOCATION=0
# Optional identity for --kind miniapp (customizedMiniApp)
# DENNIS_PHOTON_MINIAPP_BUNDLE_ID=com.example.dennis.imessage
# DENNIS_PHOTON_MINIAPP_TEAM_ID=ABCDE12345
APPROVAL_TTL_MINUTES=30
LOG_LEVEL=info
NEXT_PUBLIC_API_MODE=mock
API_BASE_URL=http://localhost:4104
DEMO_ALICE_HANDLE=alice@example.test
DEMO_BOB_HANDLE=bob@example.test
# Current group-chat demo cast. Use E.164 phone numbers or Apple ID emails.
DEMO_JOHN_HANDLE=john@example.test
DEMO_STEVEN_HANDLE=steven@example.test
DEMO_ISAAC_HANDLE=isaac@example.test
# Seeded matching friend; this person is not a member of the live demo group.
DEMO_FRIEND_HANDLE=friend@example.test
DEMO_SCENARIO=group
PHOTON_MODE=sim
PHOTON_API_BASE_URL=https://api.photon.codes
PHOTON_PROJECT_ID=
# Spectrum Cloud credential shown as "Project secret" in the Photon dashboard.
PHOTON_PROJECT_SECRET=
# Legacy Photon Beta credentials; leave blank for Spectrum projects.
PHOTON_API_KEY=
PHOTON_AGENT_USER_ID=
PHOTON_INBOUND=socketio
PHOTON_SPACE_MODE=either
PHOTON_SOCKET_URL=
PHOTON_WEBHOOK_SECRET=
PHOTON_ACCOUNT_KEY=primary
NESSIE_MODE=sim
NESSIE_API_KEY=
NESSIE_BASE_URL=
NESSIE_MAX_TRANSFER_CENTS=50000
NESSIE_RUN_TAG=
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_MS=8000
CHALK_API_TOKEN=
CHALK_GATEWAY_BASE_URL=
CHALK_GATEWAY_MODEL=
LIVE_TESTS=0
